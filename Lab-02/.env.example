# Copie este arquivo para `.env` e preencha os valores antes de rodar os scripts.

# Assistente de IA usado em TODOS os trials com IA (precisa ser o mesmo do
# início ao fim do experimento — ver Issue #47 / docs/ambiente-execucao.md).
# Fechado: Claude. Modelo específico não fixado por enquanto — se continuar
# em aberto, registre o modelo efetivo por trial em data/raw/log_trials.csv
# em vez de confiar só nesta variável (ver pendência no doc acima).
AI_ASSISTANT_NAME=Claude
AI_ASSISTANT_VERSION=

# Time-box por trial, em minutos. Fixo em 35 pelo enunciado — só pode ser
# reduzido (e justificado no relatório), nunca aumentado.
TRIAL_TIMEBOX_MIN=35

# Reaproveitados do Lab-01 para o script de snapshot do GitHub Projects
# (scripts/README_lucasrsnd.md — Issue [S01] Setup do GitHub Projects).
GITHUB_TOKEN=
GITHUB_PROJECT_OWNER=lucasrsnd
GITHUB_PROJECT_NUMBER=2
