# Copie este arquivo para ".env" (na pasta Lab-01) e preencha com um token seu.
# Gere em: https://github.com/settings/tokens  (classic token, sem escopos marcados ja basta pra ler dados publicos)
# NUNCA commite o arquivo ".env" de verdade — ele ja esta no .gitignore da raiz do repo.
GITHUB_TOKEN=coloque_seu_token_aqui
